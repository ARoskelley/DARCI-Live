<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:DarciControl.App"
        x:Class="DarciControl.App.MainWindow"
        Title="DARCI Control Centre"
        Width="980" Height="720"
        MinWidth="720" MinHeight="520">

  <DockPanel>

    <!-- Connection state is always visible. The single most common question this app answers is
         "is DARCI running", and burying that in a tab would mean hunting for it. -->
    <Border DockPanel.Dock="Top" Padding="12,8" Background="#1E1E1E">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#888888" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusDetail" Text="" VerticalAlignment="Center" Opacity="0.6" />
      </StackPanel>
    </Border>

    <TabControl>

      <!-- ── Chat ── -->
      <TabItem Header="Chat">
        <DockPanel Margin="12">

          <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="MessageBox" Grid.Column="0"
                       Watermark="Message DARCI..."
                       AcceptsReturn="False"
                       KeyDown="OnMessageKeyDown" />
              <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0"
                      Content="Send" Click="OnSendClick" MinWidth="80" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="False" x:Name="ChatHintPanel">
            <TextBlock x:Name="ChatHint" TextWrapping="Wrap" Opacity="0.75" />
          </Border>

          <ScrollViewer x:Name="ChatScroll">
            <ItemsControl x:Name="Messages">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:ChatEntry">
                  <Border Margin="0,4" Padding="10,8" CornerRadius="6"
                          Background="{Binding Background}"
                          HorizontalAlignment="{Binding Alignment}"
                          MaxWidth="620">
                    <StackPanel>
                      <TextBlock Text="{Binding Who}" FontWeight="SemiBold" FontSize="11" Opacity="0.65" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
                      <TextBlock Text="{Binding Note}" FontSize="10" Opacity="0.5" Margin="0,3,0,0"
                                 IsVisible="{Binding HasNote}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

        </DockPanel>
      </TabItem>

      <!-- ── Start DARCI (D3) ── -->
      <TabItem Header="Start DARCI">
        <StackPanel Margin="16" Spacing="10">
          <TextBlock Text="Prerequisites" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Opacity="0.7" TextWrapping="Wrap"
                     Text="Checks .NET, Ollama, the models this host profile requires, and the knowledge graph. Nothing is installed for you - each result tells you the command to run." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CheckButton" Content="Run checks" Click="OnCheckClick" />
            <Button x:Name="StartCoreButton" Content="Start DARCI" Click="OnStartCoreClick" />
            <Button x:Name="StopCoreButton" Content="Stop" Click="OnStopCoreClick" IsEnabled="False" />
            <Button x:Name="StartNeo4jButton" Content="Start Neo4j" Click="OnStartNeo4jClick" IsEnabled="False" />
          </StackPanel>
          <TextBlock x:Name="StartLog" TextWrapping="Wrap" Opacity="0.8" FontFamily="Consolas,Menlo,monospace" FontSize="11" />
          <ItemsControl x:Name="PrereqList" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:PrereqRow">
                <Border Margin="0,3" Padding="10,7" CornerRadius="4" Background="#252525">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Badge}" Foreground="{Binding Colour}" FontWeight="Bold" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Opacity="0.65" />
                    </StackPanel>
                    <TextBlock Text="{Binding Remedy}" FontFamily="Consolas,Menlo,monospace" FontSize="11"
                               Opacity="0.8" Margin="0,4,0,0" IsVisible="{Binding HasRemedy}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </TabItem>

      <!-- ── Build distributable (D4) ── -->
      <TabItem Header="Build distributable">
        <StackPanel Margin="16" Spacing="10">
          <TextBlock Text="Build a distributable" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Opacity="0.7" TextWrapping="Wrap"
                     Text="Produces a self-contained zip - the recipient needs no .NET SDK. Selecting no nodes is valid: a bare core runs and honestly reports that no capabilities are available." />

          <TextBlock Text="Nodes to include" FontWeight="SemiBold" Margin="0,8,0,0" />
          <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="220">
            <ScrollViewer>
              <ItemsControl x:Name="NodeList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:NodeRow">
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsSelectable}" Margin="0,2">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Version}" Opacity="0.5" />
                          <TextBlock Text="{Binding Transport}" Opacity="0.5" />
                        </StackPanel>
                        <TextBlock Text="{Binding Capabilities}" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="#D9534F"
                                   IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Target:" VerticalAlignment="Center" />
              <ComboBox x:Name="TargetCombo" SelectedIndex="0" MinWidth="150">
                <ComboBoxItem Content="Windows (win-x64)" />
                <ComboBoxItem Content="Linux (linux-x64)" />
              </ComboBox>
            </StackPanel>
            <CheckBox x:Name="OnnxCheck" Content="Include ONNX models (large)" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshNodesButton" Content="Refresh nodes" Click="OnRefreshNodesClick" />
            <Button x:Name="BuildZipButton" Content="Build zip..." Click="OnBuildZipClick" />
          </StackPanel>

          <TextBlock x:Name="BuildLog" TextWrapping="Wrap" Opacity="0.85"
                     FontFamily="Consolas,Menlo,monospace" FontSize="11" />
        </StackPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
