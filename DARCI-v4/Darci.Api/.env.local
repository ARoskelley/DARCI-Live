# Copy this file to .env.local and fill in only the integrations you want.
# .env.local is loaded by DARCI-v4/Darci.Api at startup and should not be committed.

# Core local model runtime
DARCI_DB_PATH=
DARCI_OLLAMA_BASE_URL=http://localhost:11434
DARCI_OLLAMA_CODING_MODEL=qwen2.5-coder:7b
DARCI_OLLAMA_FAST_CODING_MODEL=llama3.2:3b
DARCI_OLLAMA_MODEL=gemma4:e4b
DARCI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional live/deep research
DARCI_TAVILY_API_KEY=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
DARCI_TAVILY_BASE_URL=https://api.tavily.com
DARCI_TAVILY_MAX_RESULTS=5
DARCI_TAVILY_SEARCH_DEPTH=advanced
DARCI_FIRECRAWL_ENABLED=true
DARCI_FIRECRAWL_API_KEY=fc-906c7fe56cd141b987811a99639b4a98
DARCI_FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Optional NLP adapter. Leave disabled until a compatible local service exists.
DARCI_NLP_ENABLED=false
DARCI_NLP_BASE_URL=http://localhost:5200

# Optional notification fanout
DARCI_EMAIL_ENABLED=false
DARCI_EMAIL_TO=
DARCI_EMAIL_FROM=
DARCI_SMTP_HOST=
DARCI_SMTP_PORT=587
DARCI_SMTP_USE_SSL=true
DARCI_SMTP_USERNAME=
DARCI_SMTP_PASSWORD=
DARCI_TELEGRAM_ENABLED=false
DARCI_TELEGRAM_BOT_TOKEN=
DARCI_TELEGRAM_CHAT_ID=
DARCI_TELEGRAM_INBOUND_ENABLED=false
DARCI_TELEGRAM_INBOUND_USER_ID=Tinman

# Optional AWS relay for mobile/cloud file delivery
DARCI_AWS_REGION=us-east-1
DARCI_AWS_KEY_ID=
DARCI_AWS_KEY_SECRET=
DARCI_SQS_INBOX=
DARCI_SQS_OUTBOX=
DARCI_S3_BUCKET=
DARCI_CLOUD_POLL_MS=2000
DARCI_CLOUD_WAIT_S=5
DARCI_PRESIGNED_MIN=60

# Optional engineering/CAD service base URLs
DARCI_PYTHON_SERVICE_BASE_URL=http://localhost:8000
