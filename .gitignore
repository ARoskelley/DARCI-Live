# Local secrets / environment files (NEVER commit real keys)
# Ignore all env files everywhere, but keep *.example templates tracked.
.env
.env.*
**/.env
**/.env.*
!**/*.example
!*.example
# Local app secrets / per-machine overrides
**/appsettings.Secrets.json
**/*.Secrets.json
**/appsettings.*.local.json
**/secrets.json
secrets.json

# Build output
**/bin/
**/obj/
.vs/

# Local imported project sandboxes
DARCI-v4/Workspaces/

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/

# IDE/user files
.idea/
*.user

# Local scratch / test sandboxes
tmp/
